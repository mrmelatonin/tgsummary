# Telegram API Credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_here

# Telethon Session String (generated using session generator or saved session)
TELEGRAM_SESSION_STRING=your_string_session_here

# Alternatively, Telegram Bot Token if sending via Bot API
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ

# Google Gemini API Key (get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Target channel/chat override (optional, defaults to config.yaml target_chat)
TARGET_CHAT=@my_summary_channel

# Optional Azure Speech (create a Free F0 Speech resource)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
